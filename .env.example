# Cloudflare R2
# 1. Tạo R2 bucket tại https://dash.cloudflare.com → R2 Object Storage
# 2. Tạo API token (Object Read & Write)
# 3. Upload models:  npm run upload-models
# 4. Copy URL public (hoặc dùng custom domain) và dán vào .env

VITE_MODEL_BASE_URL=https://your-r2-bucket.your-subdomain.workers.dev

# Nếu dùng R2 qua Wrangler (dev), uncomment dòng dưới:
# VITE_MODEL_BASE_URL=http://localhost:8787
