# Runtime: FE gọi model qua backend API (Vite proxy /api -> http://localhost:8080)
VITE_MODEL_API_BASE=/api/models

# Google Analytics 4 (GA4)
# Mã định danh luồng web: G-XXXXXXXXXX (Lấy từ Google Analytics > Quản trị > Luồng dữ liệu)
VITE_GA4_MEASUREMENT_ID=

# PostHog Analytics & Session Replay
# Project API Key: phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (Lấy từ PostHog > Project Settings)
VITE_POSTHOG_KEY=
# Host API (US Cloud: https://us.i.posthog.com, EU Cloud: https://eu.i.posthog.com, hoặc Self-hosted URL)
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Chỉ dùng cho script `npm run upload-models`, không dùng lúc chạy app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bio3d-models

